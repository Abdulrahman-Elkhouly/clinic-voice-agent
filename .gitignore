# Secrets: never commit API keys
.env

# Python virtual environment (recreated with pip install)
.venv/

# Python cache files
__pycache__/
*.pyc

# Databases (Stage 2+): may hold patient data
*.db
*.sqlite3
# SQLite's WAL-mode side files hold recent writes too
*.db-wal
*.db-shm
data/

# Test cache
.pytest_cache/
